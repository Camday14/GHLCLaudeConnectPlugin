# ---------- Desktop extension / local stdio server ----------
GHL_API_KEY=pit-xxxxxxxx
GHL_LOCATION_ID=your-location-id
# GHL_READ_ONLY=true
# GHL_BULK_CONFIRM_THRESHOLD=1
# GHL_DEFAULT_COUNTRY_CODE=1

# ---------- Hosted connector (npm run start:remote) ----------
# PUBLIC_URL=https://your-app.up.railway.app      # Railway sets RAILWAY_PUBLIC_DOMAIN automatically
# DATABASE_URL=postgres://...                    # omit to use embedded PGlite in ./data (local testing only)
# ENCRYPTION_KEY=                                 # openssl rand -base64 32
# CONNECT_PASSCODE=                               # your team's passcode on the login page
# ALLOWED_LOCATION_IDS=locId1,locId2              # only these GHL sub-accounts may connect
# ADMIN_PASSWORD=                                 # enables /admin
# GHL_CLIENT_ID=                                  # optional: enables "Log in with GoHighLevel"
# GHL_CLIENT_SECRET=
# WEBHOOK_SECRET=                                 # enables instant automation triggers at /webhooks/ghl/<secret>
# GHL_WEBHOOK_PUBLIC_KEY=                         # optional: also verify GHL webhook signatures
